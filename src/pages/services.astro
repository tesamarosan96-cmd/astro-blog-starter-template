---
import Layout from '../layouts/BlogPost.astro';
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Services - WelcomeToSerbia Shop</title>
    <style>
      /* Import your Serbia Sans font - CORRECTED PATH */
      @font-face {
        font-family: 'Serbia Sans';
        src: url('/font/Srbija-sans.woff') format('woff');
        font-weight: normal;
        font-style: normal;
      }

      body {
        font-family: 'Serbia Sans', sans-serif; /* Use your font */
        margin: 0;
        background-color: #f0f4f8; /* Light blue background */
        color: #333;
      }

      header {
        background: #0056b3; /* Darker blue */
        padding: 1em 2em;
        box-shadow: 0 4px 12px rgba(0, 86, 179, 0.2);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo {
        color: white;
        font-size: 1.5rem;
        font-weight: bold;
      }

      .internal-links {
        display: flex;
        gap: 1em;
      }

      .internal-links a {
        text-decoration: none;
        color: #e0e7ff; /* Light blue/white for links */
        padding: 0.5em 1em;
        border-radius: 6px;
        transition: background-color 0.3s ease, color 0.3s ease;
      }

      .internal-links a:hover {
        background-color: #ffffff;
        color: #0056b3;
      }

      .services-section {
        padding: 60px 20px;
        text-align: center;
        max-width: 1200px;
        margin: 0 auto;
      }

      .services-section h1 {
        font-size: 2.8rem;
        color: #0056b3; /* Blue title */
        margin-bottom: 10px;
      }

      .services-section p {
        font-size: 1.1rem;
        color: #555;
        margin-bottom: 40px;
      }

      .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
        margin-top: 20px;
      }

      .service-card {
        background: #ffffff;
        padding: 40px 30px;
        border-radius: 16px;
        box-shadow: 0 8px 20px rgba(0, 86, 179, 0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        text-align: left;
        display: flex;
        flex-direction: column;
        height: 100%;
        border-top: 5px solid #007bff; /* Blue accent bar */
      }

      .service-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 30px rgba(0, 86, 179, 0.15);
      }

      .service-card h2 {
        font-size: 1.6rem;
        color: #0056b3;
        margin-bottom: 15px;
        font-weight: 600;
      }

      .service-card p {
        color: #555;
        line-height: 1.6;
        flex-grow: 1;
        margin: 0;
      }
    </style>
</head>
<body>
    <header>
        <div class="logo">WelcomeToSerbia Shop</div>
        <nav class="internal-links">
            <a href="/">Home</a>
            <a href="/blog">Blog</a>
            <a href="/about">About</a>
            <a href="/services">Services</a>
        </nav>
    </header>

    <main>
        <section class="services-section">
            <h1>Our Services</h1>
            <p>We offer a range of professional services tailored to meet your needs.</p>

            <div class="services-grid">
                <!-- Service 1 -->
                <div class="service-card">
                    <h2>Opening a Legal Entity</h2>
                    <p>Help with registering your business as an Entrepreneur or LLC in Serbia.</p>
                </div>

                <!-- Service 2 -->
                <div class="service-card">
                    <h2>Opening a Bank Account</h2>
                    <p>Assistance with opening a business or personal bank account in Serbia.</p>
                </div>

                <!-- Service 3 -->
                <div class="service-card">
                    <h2>Visa Application</h2>
                    <p>Guidance and support for your Serbian visa application process.</p>
                </div>

                <!-- Service 4 -->
                <div class="service-card">
                    <h2>Virtual Address</h2>
                    <p>Provision of a virtual address for your company registration needs.</p>
                </div>

                <!-- Service 5 -->
                <div class="service-card">
                    <h2>Temporary Residence</h2>
                    <p>Complete application support for temporary residence permits.</p>
                </div>

                <!-- Service 6 -->
                <div class="service-card">
                    <h2>Permanent Residence</h2>
                    <p>Expert assistance with applying for permanent residence in Serbia.</p>
                </div>

                <!-- Service 7 -->
                <div class="service-card">
                    <h2>Buying Property</h2>
                    <p>Support for purchasing property in Serbia, including Power of Attorney (POA) services.</p>
                </div>

