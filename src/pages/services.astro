---
// This is a simple page without a separate layout file
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Services - WelcomeToSerbia Shop</title>
    <style>
      body {
        font-family: sans-serif;
        margin: 0;
        background-color: #f9f9f9;
      }
      header {
        background: white;
        padding: 1em 2em;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .internal-links {
        display: flex;
        gap: 1em;
      }
      .internal-links a {
        text-decoration: none;
        color: #333;
        padding: 0.5em;
        border-bottom: 2px solid transparent;
      }
      .internal-links a:hover {
        border-bottom-color: #0070f3;
      }
      .services-section {
        padding: 60px 20px;
        text-align: center;
        max-width: 1200px;
        margin: 0 auto;
      }
      .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 30px;
        margin-top: 40px;
      }
      .service-card {
        background: #fff;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        transition: transform 0.3s ease;
        text-align: left;
        display: flex;
        flex-direction: column;
        height: 100%;
      }
      .service-card:hover {
        transform: translateY(-5px);
      }
      .service-card h2 {
        font-size: 1.5rem;
        color: #333;
        margin-bottom: 10px;
      }
      .service-card p {
        color: #666;
        line-height: 1.6;
        flex-grow: 1;
      }
    </style>
</head>
<body>
    <header>
        <div class="logo">WelcomeToSerbia Shop</div>
        <nav class="internal-links">
            <a href="/">Home</a>
            <a href="/blog">Blog</a>
            <a href="/about">About</a>
            <a href="/services">Services</a>
        </nav>
    </header>

    <main>
        <section class="services-section">
            <h1>Our Services</h1>
            <p>We offer a range of professional services tailored to meet your needs.</p>

            <div class="services-grid">
                <!-- Service 1 -->
                <div class="service-card">
                    <h2>Opening a Legal Entity</h2>
                    <p>Help with registering your business as an Entrepreneur or LLC in Serbia.</p>
                </div>

                <!-- Service 2 -->
                <div class="service-card">
                    <h2>Opening a Bank Account</h2>
                    <p>Assistance with opening a business or personal bank account in Serbia.</p>
                </div>

                <!-- Service 3 -->
                <div class="service-card">
                    <h2>Visa Application</h2>
                    <p>Guidance and support for your Serbian visa application process.</p>
                </div>

                <!-- Service 4 -->
                <div class="service-card">
                    <h2>Virtual Address</h2>
                    <p>Provision of a virtual address for your company registration needs.</p>
                </div>

                <!-- Service 5 -->
                <div class="service-card">
                    <h2>Temporary Residence</h2>
                    <p>Complete application support for temporary residence permits.</p>
                </div>

                <!-- Service 6 -->
                <div class="service-card">
                    <h2>Permanent Residence</h2>
                    <p>Expert assistance with applying for permanent residence in Serbia.</p>
                </div>

                <!-- Service 7 -->
                <div class="service-card">
                    <h2>Buying Property</h2>
                    <p>Support for purchasing property in Serbia, including Power of Attorney (POA) services.</p>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
