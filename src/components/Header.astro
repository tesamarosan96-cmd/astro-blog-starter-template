---
/*
 * WelcomeToSerbia Shop
 * Responsive Header
 *
 * Includes:
 * - Logo
 * - Desktop navigation
 * - Mobile hamburger menu
 * - Google Translate
 * - Instagram
 * - X
 * - Facebook
 */
---

<style is:global>

  /* =========================================================
     FONT
     ========================================================= */

  @font-face {
    font-family: 'Serbia Sans';

    src:
      url('/font/Srbija-sans.woff') format('woff'),
      url('/fonts/Srbija-sans.woff') format('woff');

    font-weight: normal;
    font-style: normal;

    font-display: swap;
  }


  /* =========================================================
     GENERAL
     ========================================================= */

  html,
  body {
    margin: 0;
    padding: 0;

    width: 100%;

    overflow-x: hidden;

    font-family: 'Serbia Sans', sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }


  /* =========================================================
     HEADER
     ========================================================= */

  header {
    width: 100%;

    background: #0056b3;

    padding: 10px 24px;

    box-shadow:
      0 4px 12px rgba(0, 86, 179, 0.20);

    position: relative;

    z-index: 1000;
  }


  /* =========================================================
     HEADER INNER
     ========================================================= */

  .header-inner {
    width: 100%;

    max-width: 1400px;

    margin: 0 auto;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;
  }


  /* =========================================================
     LOGO
     ========================================================= */

  .logo {
    display: flex;

    align-items: center;

    gap: 10px;

    color: white;

    text-decoration: none;

    flex-shrink: 0;

    min-width: 0;
  }

  .logo:hover {
    text-decoration: none;
  }

  .logo img {
    width: 62px;

    height: 62px;

    object-fit: contain;

    display: block;

    flex-shrink: 0;
  }

  .logo-text {
    display: flex;

    flex-direction: column;

    justify-content: center;

    color: white;

    font-size: 15px;

    font-weight: bold;

    line-height: 1.15;

    white-space: nowrap;
  }

  .logo-text span {
    display: block;
  }


  /* =========================================================
     DESKTOP RIGHT SIDE
     ========================================================= */

  .header-right {
    display: flex;

    align-items: center;

    justify-content: flex-end;

    gap: 15px;

    min-width: 0;
  }


  /* =========================================================
     NAVIGATION
     ========================================================= */

  nav {
    display: flex;

    align-items: center;
  }

  .internal-links {
    display: flex;

    align-items: center;

    gap: 4px;

    flex-wrap: nowrap;
  }

  .internal-links a {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    color: #ffffff;

    text-decoration: none;

    padding: 8px 11px;

    border-radius: 6px;

    font-size: 15px;

    font-weight: 600;

    white-space: nowrap;

    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }

  .internal-links a:hover {
    background-color: #ffffff;

    color: #0056b3;

    text-decoration: none;
  }


  /* =========================================================
     LANGUAGE CONTROL
     
     IMPORTANT:
     There is NO white box around the language control.
     ========================================================= */

  .translate-control {
    display: flex;

    align-items: center;

    gap: 6px;

    color: white;

    white-space: nowrap;

    flex-shrink: 0;
  }

  .translate-label {
    color: white;

    font-family: 'Serbia Sans', sans-serif;

    font-size: 14px;

    font-weight: 600;

    white-space: nowrap;
  }


  /* Google Translate itself */

  #google_translate_element {
    display: inline-flex;

    align-items: center;

    background: transparent;

    border: none;

    padding: 0;

    margin: 0;

    min-height: 30px;
  }

  #google_translate_element .goog-te-gadget {
    font-family: Arial, sans-serif !important;

    font-size: 0 !important;

    line-height: 1 !important;

    color: white !important;
  }

  #google_translate_element .goog-te-gadget select {
    font-family: Arial, sans-serif !important;

    font-size: 13px !important;

    color: #ffffff !important;

    background: transparent !important;

    border: none !important;

    border-radius: 4px;

    padding: 4px 3px;

    min-width: 82px;

    height: 30px;

    cursor: pointer;

    outline: none;
  }

  #google_translate_element .goog-te-gadget select option {
    color: #333333;

    background: #ffffff;
  }

  #google_translate_element .goog-te-gadget select:hover {
    background: rgba(255, 255, 255, 0.12) !important;
  }

  #google_translate_element .goog-te-gadget > span {
    display: none !important;
  }


  /* =========================================================
     GOOGLE TRANSLATE BANNER
     ========================================================= */

  .goog-te-banner-frame {
    display: none !important;
  }

  body {
    top: 0 !important;
  }

  .goog-te-balloon-frame {
    display: none !important;
  }


  /* =========================================================
     SOCIAL LINKS
     ========================================================= */

  .social-links {
    display: flex;

    align-items: center;

    gap: 9px;

    flex-shrink: 0;
  }

  .social-links a {
    display: flex;

    align-items: center;

    justify-content: center;

    width: 32px;

    height: 32px;

    color: white;

    text-decoration: none;

    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  .social-links a:hover {
    opacity: 0.8;

    transform: scale(1.08);

    text-decoration: none;
  }

  .social-links img {
    width: 24px;

    height: 24px;

    object-fit: contain;

    border-radius: 0;
  }

  .social-links svg {
    width: 26px;

    height: 26px;

    display: block;
  }


  /* =========================================================
     MOBILE MENU BUTTON
     ========================================================= */

  .mobile-menu-button {
    display: none;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;

    width: 44px;

    height: 40px;

    padding: 0;

    border: 1px solid rgba(255, 255, 255, 0.55);

    border-radius: 7px;

    background: rgba(255, 255, 255, 0.08);

    color: white;

    font-size: 23px;

    line-height: 1;

    cursor: pointer;
  }

  .mobile-menu-button:hover {
    background: white;

    color: #0056b3;
  }


  /* =========================================================
     MOBILE MENU
     ========================================================= */

  .mobile-menu {
    display: none;

    width: 100%;

    max-width: 1400px;

    margin: 10px auto 0;

    padding: 12px 0 4px;

    border-top:
      1px solid rgba(255, 255, 255, 0.25);
  }

  .mobile-menu.open {
    display: block;
  }

  .mobile-menu .internal-links {
    display: flex;

    flex-direction: column;

    align-items: stretch;

    width: 100%;

    gap: 3px;
  }

  .mobile-menu .internal-links a {
    display: flex;

    align-items: center;

    justify-content: flex-start;

    width: 100%;

    padding: 10px 8px;

    color: white;

    font-size: 16px;

    border-radius: 6px;
  }

  .mobile-menu .internal-links a:hover {
    background: white;

    color: #0056b3;
  }


  /* =========================================================
     MOBILE LANGUAGE
     ========================================================= */

  .mobile-translate {
    display: flex;

    align-items: center;

    gap: 8px;

    width: 100%;

    margin-top: 10px;

    padding: 11px 8px;

    border-top:
      1px solid rgba(255, 255, 255, 0.25);
  }

  .mobile-translate .translate-control {
    display: flex;

    align-items: center;

    width: 100%;

    gap: 8px;
  }

  .mobile-translate .translate-label {
    font-size: 15px;
  }

  .mobile-translate #google_translate_element {
    display: inline-flex;

    align-items: center;
  }

  .mobile-translate
  #google_translate_element
  .goog-te-gadget
  select {
    min-width: 100px;

    height: 32px;

    padding: 4px;

    font-size: 14px !important;

    color: white !important;

    background: transparent !important;
  }


  /* =========================================================
     MOBILE SOCIAL LINKS
     ========================================================= */

  .mobile-social {
    display: flex;

    align-items: center;

    gap: 12px;

    margin-top: 10px;

    padding: 11px 8px 4px;

    border-top:
      1px solid rgba(255, 255, 255, 0.25);
  }

  .mobile-social a {
    display: flex;

    align-items: center;

    justify-content: center;

    width: 32px;

    height: 32px;

    color: white;

    text-decoration: none;
  }

  .mobile-social img {
    width: 24px;

    height: 24px;

    object-fit: contain;

    border-radius: 0;
  }

  .mobile-social svg {
    width: 26px;

    height: 26px;
  }


  /* =========================================================
     TABLET
     ========================================================= */

  @media (max-width: 1100px) {

    header {
      padding:
        9px 16px;
    }

    .header-inner {
      gap: 10px;
    }

    .logo {
      gap: 8px;
    }

    .logo img {
      width: 55px;

      height: 55px;
    }

    .logo-text {
      font-size: 14px;
    }

    .header-right {
      gap: 7px;
    }

    .internal-links {
      gap: 1px;
    }

    .internal-links a {
      padding:
        7px 7px;

      font-size: 14px;
    }

    .social-links {
      display: none;
    }

    .translate-label {
      display: none;
    }
  }


  /* =========================================================
     MOBILE
     ========================================================= */

  @media (max-width: 720px) {

    header {
      padding:
        9px 12px;
    }

    .header-inner {
      width: 100%;

      gap: 8px;
    }

    .logo {
      max-width:
        calc(100% - 55px);

      gap: 8px;
    }

    .logo img {
      width: 48px;

      height: 48px;
    }

    .logo-text {
      font-size: 13px;

      line-height: 1.15;

      white-space: normal;
    }


    /* Hide desktop navigation */

    .header-right {
      display: none;
    }


    /* Show hamburger */

    .mobile-menu-button {
      display: inline-flex;
    }


    /* Mobile menu */

    .mobile-menu {
      display: none;
    }

    .mobile-menu.open {
      display: block;
    }


    /* Mobile language */

    .mobile-translate {
      display: flex;
    }
  }


  /* =========================================================
     SMALL PHONES
     ========================================================= */

  @media (max-width: 380px) {

    header {
      padding:
        8px 9px;
    }

    .logo {
      gap: 6px;
    }

    .logo img {
      width: 43px;

      height: 43px;
    }

    .logo-text {
      font-size: 12px;
    }

    .mobile-menu-button {
      width: 40px;

      height: 37px;

      font-size: 21px;
    }

    .mobile-menu .internal-links a {
      font-size: 15px;

      padding:
        9px 7px;
    }
  }

</style>


<!-- =========================================================
     HEADER
     ========================================================= -->

<header>

  <div class="header-inner">

    <!-- LOGO -->

    <a
      href="/"
      class="logo"
      aria-label="Welcome To Serbia Shop - Home"
    >

      <img
        src="/favicon.webp"
        alt="WelcomeToSerbia Shop"
      />

      <div class="logo-text">
        <span>WELCOME TO</span>
        <span>SERBIA SHOP</span>
      </div>

    </a>


    <!-- =====================================================
         DESKTOP RIGHT SIDE
         ===================================================== -->

    <div class="header-right">

      <!-- NAVIGATION -->

      <nav aria-label="Main navigation">

        <div class="internal-links">

          <a href="/">Home</a>

          <a href="/blog">Blog</a>

          <a href="/about">About</a>

          <a href="/services">Services</a>

        </div>

      </nav>


      <!-- LANGUAGE -->

      <div class="translate-control">

        <span class="translate-label">
          🌐 Language
        </span>

        <div id="google_translate_element"></div>

      </div>


      <!-- SOCIAL MEDIA -->

      <div class="social-links">

        <a
          href="https://www.instagram.com/residencyinserbia/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
        >

          <img
            src="/INSTACIRCLE.png"
            alt="Instagram"
            width="24"
            height="24"
          />

        </a>


        <a
          href="https://x.com/welcometos53932"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="X"
        >

          <svg
            viewBox="0 0 16 16"
            aria-hidden="true"
          >
            <path
              fill="currentColor"
              d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a3.286 3.286 0 0 0-.95 2.282c0 .182.021.359.06.53A9.325 9.325 0 0 1 1.26 3.07a3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
            />
          </svg>

        </a>


        <a
          href="https://www.facebook.com/profile.php?id=61585637589638"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
        >

          <img
            src="/FBBLACK.webp"
            alt="Facebook"
            width="24"
            height="24"
          />

        </a>

      </div>

    </div>


    <!-- =====================================================
         MOBILE MENU BUTTON
         ===================================================== -->

    <button
      class="mobile-menu-button"
      id="mobile-menu-button"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
    >
      ☰
    </button>

  </div>


  <!-- =======================================================
       MOBILE MENU
       ======================================================= -->

  <div
    class="mobile-menu"
    id="mobile-menu"
  >

    <!-- MOBILE NAVIGATION -->

    <nav aria-label="Mobile navigation">

      <div class="internal-links">

        <a href="/">Home</a>

        <a href="/blog">Blog</a>

        <a href="/about">About</a>

        <a href="/services">Services</a>

      </div>

    </nav>


    <!-- MOBILE LANGUAGE -->

    <div class="mobile-translate">

      <div class="translate-control">

        <span class="translate-label">
          🌐 Language
        </span>

        <!--
          IMPORTANT:
          This is the SAME Google Translate element.
          JavaScript moves it here when the mobile menu
          is opened.
        -->

        <div
          id="mobile-translate-placeholder"
          aria-hidden="true"
        ></div>

      </div>

    </div>


    <!-- MOBILE SOCIAL MEDIA -->

    <div class="mobile-social">

      <a
        href="https://www.instagram.com/residencyinserbia/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
      >

        <img
          src="/INSTACIRCLE.png"
          alt="Instagram"
          width="24"
          height="24"
        />

      </a>


      <a
        href="https://x.com/welcometos53932"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="X"
      >

        <svg
          viewBox="0 0 16 16"
          aria-hidden="true"
        >
          <path
            fill="currentColor"
            d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a3.286 3.286 0 0 0-.95 2.282c0 .182.021.359.06.53A9.325 9.325 0 0 1 1.26 3.07a3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
          />
