---
/*
 * Main site header and footer.
 * Responsive version for desktop, tablet and mobile.
 */
---

<style is:global>
  /* =========================================================
     GLOBAL SITE STYLES
     ========================================================= */

  @font-face {
    font-family: 'Serbia Sans';
    src: url('/font/Srbija-sans.woff') format('woff');
    font-weight: normal;
    font-style: normal;
  }

  html,
  body {
    font-family: 'Serbia Sans', sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f0f4f8;
    color: #333;
    overflow-x: hidden;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  main {
    max-width: 1200px;
    width: 100%;
    margin: 2em auto;
    padding: 0 1em;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    color: #0056b3;
  }

  p,
  li {
    color: #555;
    line-height: 1.7;
  }

  a {
    color: #007bff;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }


  /* =========================================================
     HEADER
     ========================================================= */

  header {
    width: 100%;
    background: #0056b3;
    box-shadow: 0 4px 12px rgba(0, 86, 179, 0.2);

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0.6em 2em;

    position: relative;
    z-index: 1000;
  }


  /* =========================================================
     LOGO
     ========================================================= */

  .logo {
    display: flex;
    align-items: center;
    gap: 12px;

    color: white;
    font-weight: bold;

    min-width: 0;
    flex-shrink: 1;
  }

  .logo img {
    width: 65px;
    height: auto;
    display: block;
    flex-shrink: 0;
  }

  .logo-text {
    display: flex;
    flex-direction: column;

    line-height: 1.15;

    color: white;
    font-size: 16px;
    font-weight: bold;

    white-space: nowrap;
  }

  .logo-text span {
    display: block;
  }


  /* =========================================================
     DESKTOP NAVIGATION
     ========================================================= */

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;

    margin-left: auto;
  }

  .internal-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .internal-links a {
    text-decoration: none;
    color: #e0e7ff;

    padding: 0.6em 0.9em;
    border-radius: 6px;

    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .internal-links a:hover {
    background-color: #ffffff;
    color: #0056b3;
    text-decoration: none;
  }


  /* =========================================================
     SOCIAL LINKS
     ========================================================= */

  .social-links {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .social-links a {
    color: white;

    display: flex;
    align-items: center;
    justify-content: center;

    text-decoration: none;
  }

  .social-links a:hover {
    opacity: 0.8;
    text-decoration: none;
  }

  .social-links img {
    display: block;
    max-width: 24px;
    height: auto;
  }

  .social-links svg {
    display: block;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }


  /* =========================================================
     GOOGLE TRANSLATE
     ========================================================= */

  .translate-control {
    display: flex;
    align-items: center;
    margin-left: 0.5rem;
  }

  #google_translate_element {
    background: white;
    border-radius: 6px;
    padding: 3px 6px;

    min-height: 32px;

    display: flex;
    align-items: center;

    overflow: hidden;
  }

  /*
   * Prevent Google's default widget from creating
   * strange margins and oversized text.
   */

  #google_translate_element .goog-te-gadget {
    font-family: 'Serbia Sans', sans-serif !important;
    font-size: 0 !important;
    line-height: 1 !important;
  }

  #google_translate_element .goog-te-gadget select {
    font-family: Arial, sans-serif !important;
    font-size: 13px !important;

    max-width: 140px;
    border: 0;
    background: white;
    color: #333;

    padding: 3px;
    outline: none;
  }

  .goog-te-banner-frame {
    display: none !important;
  }

  body {
    top: 0 !important;
  }


  /* =========================================================
     MOBILE MENU BUTTON
     ========================================================= */

  .mobile-menu {
    display: none;
  }

  .mobile-menu summary {
    list-style: none;
    cursor: pointer;

    width: 46px;
    height: 42px;

    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 7px;

    color: white;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 0;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu summary::before {
    content: '☰';

    font-size: 26px;
    line-height: 1;
    color: white;
  }

  .mobile-menu[open] summary::before {
    content: '×';
    font-size: 30px;
  }

  .mobile-menu-content {
    position: absolute;

    top: calc(100% + 8px);
    left: 10px;
    right: 10px;

    background: white;

    border-radius: 12px;

    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);

    padding: 12px;

    display: flex;
    flex-direction: column;

    gap: 5px;
  }

  .mobile-menu-content a {
    display: block;

    color: #0056b3;

    font-size: 18px;
    font-weight: 600;

    padding: 13px 15px;

    border-radius: 7px;

    text-decoration: none;
  }

  .mobile-menu-content a:hover,
  .mobile-menu-content a:active {
    background: #f0f4f8;
    text-decoration: none;
  }

  .mobile-social-links {
    display: flex;
    justify-content: center;
    gap: 20px;

    padding: 12px 0 5px;

    border-top: 1px solid #e5e7eb;

    margin-top: 5px;
  }

  .mobile-social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
  }


  /* =========================================================
     TABLET
     ========================================================= */

  @media (max-width: 1000px) {

    header {
      padding: 0.6em 1.2em;
    }

    .desktop-nav {
      gap: 0.5rem;
    }

    .internal-links {
      gap: 0.1rem;
    }

    .internal-links a {
      padding: 0.5em 0.6em;
    }

    .logo-text {
      font-size: 15px;
    }

    .logo img {
      width: 60px;
    }

  }


  /* =========================================================
     MOBILE
     ========================================================= */

  @media (max-width: 720px) {

    header {
      padding: 8px 12px 10px;

      display: grid;

      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "logo menu"
        "translate translate";

      align-items: center;

      gap: 8px;
    }


    /* -------------------------
       Mobile logo
       ------------------------- */

    .logo {
      grid-area: logo;

      gap: 8px;

      min-width: 0;
    }

    .logo img {
      width: 52px;
      height: auto;
    }

    .logo-text {
      font-size: 13px;
      line-height: 1.15;

      white-space: normal;
    }


    /* -------------------------
       Hide desktop navigation
       ------------------------- */

    .desktop-nav {
      display: none;
    }


    /* -------------------------
       Show mobile menu
       ------------------------- */

    .mobile-menu {
      display: block;
      grid-area: menu;
    }


    /* -------------------------
       Translation
       ------------------------- */

    .translate-control {
      grid-area: translate;

      width: 100%;

      margin: 0;

      display: flex;
      justify-content: flex-start;
    }

    #google_translate_element {
      width: auto;
      max-width: 100%;
    }

    #google_translate_element .goog-te-gadget select {
      max-width: 170px;
      font-size: 13px !important;
    }


    /* -------------------------
       Main content
       ------------------------- */

    main {
      width: 100%;
      max-width: 100%;

      margin: 1.2em auto;

      padding-left: 12px;
      padding-right: 12px;
    }

  }


  /* =========================================================
     SMALL PHONES
     ========================================================= */

  @media (max-width: 400px) {

    header {
      padding-left: 9px;
      padding-right: 9px;
    }

    .logo img {
      width: 48px;
    }

    .logo-text {
      font-size: 12px;
    }

    .mobile-menu summary {
      width: 42px;
      height: 40px;
    }

    main {
      padding-left: 10px;
      padding-right: 10px;
    }

  }


  /* =========================================================
     FOOTER
     ========================================================= */

  footer {
    width: 100%;

    text-align: center;

    padding: 40px 20px;

    background: #ffffff;

    color: #333;

    margin-top: 40px;

    box-sizing: border-box;
  }

  footer p {
    margin: 0;

    color: #555;

    line-height: 1.5;
  }


  /* =========================================================
     FOOTER MOBILE
     ========================================================= */

  @media (max-width: 720px) {

    footer {
      padding: 30px 15px;

      margin-top: 30px;
    }

    footer p {
      font-size: 14px;
    }

  }
</style>


<!-- =========================================================
     HEADER
     ========================================================= -->

<header>

  <!-- LOGO -->
  <div class="logo">

    <img
