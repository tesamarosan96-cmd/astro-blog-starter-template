      <a
        href="https://www.facebook.com/profile.php?id=61585637589638"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook"
      >

        <img
          src="/FBBLACK.webp"
          alt="Facebook"
          width="24"
          height="24"
        />

      </a>

    </div>

  </div>

</header>


<!-- =========================================================
     GOOGLE TRANSLATE SCRIPT
     ========================================================= -->

<script is:inline>

  function googleTranslateElementInit() {

    new google.translate.TranslateElement(
      {
        pageLanguage: 'en',

        includedLanguages: 'en,ru',

        autoDisplay: false,

        layout:
          google.translate.TranslateElement.InlineLayout.SIMPLE
      },

      'google_translate_element'
    );

  }

</script>


<script
  is:inline
  src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"
></script>


<!-- =========================================================
     MOBILE MENU SCRIPT
     ========================================================= -->

<script is:inline>

  const menuButton =
    document.getElementById('mobile-menu-button');

  const mobileMenu =
    document.getElementById('mobile-menu');

  const translateElement =
    document.getElementById('google_translate_element');

  const desktopTranslate =
    document.querySelector('.header-right .translate-control');

  const mobileTranslatePlaceholder =
    document.getElementById(
      'mobile-translate-placeholder'
    );


  /* =========================================================
     MOVE TRANSLATION CONTROL BETWEEN DESKTOP / MOBILE
     ========================================================= */

  function updateTranslationPosition() {

    if (
      !translateElement ||
      !desktopTranslate ||
      !mobileTranslatePlaceholder
    ) {
      return;
    }

    /*
     * On mobile, move the actual Google Translate
     * element into the mobile menu.
     */

    if (window.innerWidth <= 720) {

      if (
        translateElement.parentElement !==
        mobileTranslatePlaceholder
      ) {

        mobileTranslatePlaceholder.appendChild(
          translateElement
        );

      }

    }

    /*
     * On desktop, move it back into the desktop
     * translation control.
     */

    else {

      if (
        translateElement.parentElement !==
        desktopTranslate
      ) {

        desktopTranslate.appendChild(
          translateElement
        );

      }

    }

  }


  /* Run when page loads */

  updateTranslationPosition();


  /* Run when screen size changes */

  window.addEventListener(
    'resize',
    updateTranslationPosition
  );


  /* =========================================================
     MOBILE MENU
     ========================================================= */

  if (menuButton && mobileMenu) {

    menuButton.addEventListener(
      'click',
      function () {

        const isOpen =
          mobileMenu.classList.toggle('open');


        menuButton.setAttribute(
          'aria-expanded',
          String(isOpen)
        );


        menuButton.setAttribute(
          'aria-label',
          isOpen
            ? 'Close menu'
            : 'Open menu'
        );


        menuButton.textContent =
          isOpen
            ? '✕'
            : '☰';

      }
    );

  }

</script>


<!-- =========================================================
     FOOTER
     ========================================================= -->

<footer
  style="
    text-align: center;
    padding: 40px 20px;
    background: #ffffff;
    margin-top: 40px;
  "
>

  <p>
    &copy; 2026 WelcomeToSerbia Shop.
    All rights reserved.
  </p>

</footer>

  
