---
// No imports needed for this simple header
---

<!-- Header with NO blue background (White/Clean) -->
<header style="padding: 1em 2em; background: white; box-shadow: 0 2px 8px rgba(0,0,0,0.05); display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 1000;">
	<div class="logo">
		<a href="/" style="color: #333; text-decoration: none; font-size: 1.5rem; font-weight: bold;">WelcomeToSerbia Shop</a>
	</div>
	<nav style="display: flex; align-items: center; gap: 2em;">
		<div class="internal-links" style="display: flex; gap: 1em;">
			<a href="/" style="color: #333; text-decoration: none; padding: 0.5em 1em; border-radius: 6px; transition: background-color 0.3s ease;">Home</a>
			<a href="/blog" style="color: #333; text-decoration: none; padding: 0.5em 1em; border-radius: 6px; transition: background-color 0.3s ease;">Blog</a>
			<a href="/about" style="color: #333; text-decoration: none; padding: 0.5em 1em; border-radius: 6px; transition: background-color 0.3s ease;">About</a>
			<a href="/services" style="color: #333; text-decoration: none; padding: 0.5em 1em; border-radius: 6px; transition: background-color 0.3s ease;">Services</a>
		</div>
		<div class="social-links" style="display: flex; gap: 1em;">
			<a href="https://www.instagram.com/residencyinserbia/" target="_blank" style="color: #333;">
				<span class="sr-only">Follow WTSS on Instagram</span>
				<img src="/INSTACIRCLE.png" alt="Instagram" width="24" style="height: auto;" />
			</a>
			<a href="https://x.com/welcometos53932" target="_blank" style="color: #333;">
				<span class="sr-only">Follow Welcome To Serbia Store on X</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
					<path fill="currentColor" d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"></path>
				</svg>
			</a>
			<a href="https://www.facebook.com/profile.php?id=61585637589638" target="_blank" style="color: #333;">
				<span class="sr-only">Go to WTSS on FB</span>
				<img src="/FBBLACK.webp" alt="Facebook" width="24" style="height: auto;" />
			</a>
		</div>
	</nav>
</header>
