---
/*
 * WelcomeToSerbia Shop - Main Header
 * Responsive desktop + mobile navigation
 * Google Translate: English / Russian
---
---

<style is:global>
  /* =========================================================
     GOOGLE TRANSLATE - GENERAL FIXES
     ========================================================= */

  /* Prevent Google's translation banner from pushing the page down */
  body {
    top: 0 !important;
  }

  .goog-te-banner-frame {
    display: none !important;
  }

  .goog-te-gadget {
    font-family: Arial, sans-serif !important;
  }

  .goog-te-gadget span {
    display: none !important;
  }

  /* The actual Google language dropdown */
  #google_translate_element .goog-te-combo {
    width: 150px;
    height: 34px;

    padding: 4px 8px;

    border: 1px solid #d6dce5;
    border-radius: 6px;

    background: #ffffff;
    color: #333333;

    font-family: Arial, sans-serif;
    font-size: 14px;

    cursor: pointer;
    outline: none;
  }

  #google_translate_element .goog-te-combo:hover {
    border-color: #0056b3;
  }

  #google_translate_element .goog-te-combo:focus {
    border-color: #0056b3;
    box-shadow: 0 0 0 2px rgba(0, 86, 179, 0.15);
  }

  /* =========================================================
     HEADER
     ========================================================= */

  .site-header {
    width: 100%;
    box-sizing: border-box;

    background: #0056b3;

    box-shadow:
      0 4px 12px rgba(0, 86, 179, 0.20);

    position: relative;
    z-index: 1000;
  }

  .header-inner {
    width: 100%;
    min-height: 70px;

    padding: 8px 24px;

    box-sizing: border-box;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;
  }

  /* =========================================================
     LOGO
     ========================================================= */

  .logo {
    display: flex;
    align-items: center;

    gap: 10px;

    flex-shrink: 0;

    text-decoration: none;
  }

  .logo:hover {
    text-decoration: none;
  }

  .logo img {
    width: 58px;
    height: 58px;

    object-fit: contain;

    display: block;

    border-radius: 0;
  }

  .logo-text {
    display: flex;
    flex-direction: column;

    justify-content: center;

    line-height: 1.05;

    color: #ffffff;

    font-size: 15px;
    font-weight: 700;

    white-space: nowrap;
  }

  .logo-text span {
    display: block;
    color: #ffffff;
  }

  /* =========================================================
     NAVIGATION
     ========================================================= */

  .main-navigation {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    gap: 18px;

    flex: 1;
  }

  .internal-links {
    display: flex;
    align-items: center;

    gap: 6px;
  }

  .internal-links a {
    display: flex;
    align-items: center;
    justify-content: center;

    padding: 8px 12px;

    border-radius: 6px;

    color: #ffffff;

    font-size: 16px;
    font-weight: 600;

    text-decoration: none;

    white-space: nowrap;

    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .internal-links a:hover {
    background-color: #ffffff;
    color: #0056b3;
    text-decoration: none;
  }

  /* =========================================================
     TRANSLATION
     ========================================================= */

  .translation-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 8px;

    flex-shrink: 0;

    padding: 5px 8px;

    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 8px;

    background: rgba(255, 255, 255, 0.08);

    min-height: 36px;

    box-sizing: border-box;
  }

  .translation-label {
    display: flex;
    align-items: center;

    gap: 5px;

    color: #ffffff;

    font-size: 14px;
    font-weight: 600;

    white-space: nowrap;
  }

  .translation-icon {
    font-size: 15px;
    line-height: 1;
  }

  #google_translate_element {
    display: flex;
    align-items: center;
    justify-content: center;

    min-height: 34px;

    margin: 0;
    padding: 0;
  }

  /* =========================================================
     SOCIAL ICONS
     ========================================================= */

  .social-links {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 8px;

    flex-shrink: 0;

    height: 36px;
  }

  .social-links a {
    width: 30px;
    height: 30px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0;
    margin: 0;

    color: #ffffff;

    text-decoration: none;

    line-height: 0;

    border-radius: 50%;

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .social-links a:hover {
    opacity: 0.8;
    transform: translateY(-1px);
    text-decoration: none;
  }

  .social-links img {
    display: block;

    width: 24px;
    height: 24px;

    object-fit: contain;

    margin: 0;

    border-radius: 0;
  }

  .social-links svg {
    display: block;

    width: 24px;
    height: 24px;

    margin: 0;
  }

  /* =========================================================
     MOBILE MENU BUTTON
     ========================================================= */

  .menu-toggle {
    display: none;

    width: 42px;
    height: 42px;

    padding: 8px;

    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 7px;

    background: transparent;

    cursor: pointer;

    flex-shrink: 0;
  }

  .menu-toggle span {
    display: block;

    width: 24px;
    height: 2px;

    margin: 5px auto;

    background: #ffffff;

    border-radius: 2px;

    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .menu-toggle:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* =========================================================
     FOOTER
     ========================================================= */

  .site-footer {
    width: 100%;

    box-sizing: border-box;

    margin-top: 40px;

    padding: 40px 20px;

    text-align: center;

    background: #ffffff;
  }

  .site-footer p {
    margin: 0;

    color: #56565d;

    font-size: 18px;
  }

  /* =========================================================
     MOBILE / TABLET
     ========================================================= */

  @media (max-width: 900px) {

    .header-inner {
      min-height: 64px;

      padding: 7px 14px;

      gap: 10px;
    }

    .logo img {
      width: 50px;
      height: 50px;
    }

    .logo-text {
      font-size: 13px;
    }

    .menu-toggle {
      display: block;
    }

    .main-navigation {
      display: none;

      position: absolute;

      top: 100%;
      left: 0;
      right: 0;

      width: 100%;

      padding: 14px;

      box-sizing: border-box;

      background: #0056b3;

      box-shadow:
        0 8px 15px rgba(0, 0, 0, 0.15);

      flex-direction: column;

      align-items: stretch;
      justify-content: flex-start;

      gap: 12px;
    }

    .main-navigation.menu-open {
      display: flex;
    }

    .internal-links {
      display: flex;

      flex-direction: column;

      width: 100%;

      gap: 4px;
    }

    .internal-links a {
      width: 100%;

      box-sizing: border-box;

      padding: 11px 14px;

      justify-content: flex-start;

      font-size: 17px;

      border-radius: 6px;
    }

    .translation-wrapper {
      width: 100%;

      justify-content: space-between;

      padding: 9px 10px;

      box-sizing: border-box;
    }

    .translation-label {
      font-size: 16px;
    }

    #google_translate_element {
      margin-left: auto;
    }

    #google_translate_element .goog-te-combo {
      width: 150px;
      height: 36px;
    }

    .social-links {
      width: 100%;

      height: auto;

      justify-content: center;

      padding-top: 6px;
    }

    .social-links a {
      width: 36px;
      height: 36px;
    }
  }

  /* =========================================================
     SMALL PHONES
     ========================================================= */

  @media (max-width: 480px) {

    .header-inner {
      padding: 6px 10px;
    }

    .logo {
      gap: 7px;
    }

    .logo img {
      width: 46px;
      height: 46px;
    }

    .logo-text {
      font-size: 12px;
    }

    .translation-wrapper {
      flex-wrap: wrap;

      gap: 7px;
    }

    .translation-label {
      font-size: 15px;
    }

    #google_translate_element {
      width: auto;
    }

    #google_translate_element .goog-te-combo {
      width: 145px;
      max-width: 100%;
    }
  }
</style>


<!-- =========================================================
     HEADER
     ========================================================= -->

<header class="site-header">

  <div class="header-inner">

    <!-- LOGO -->
    <a href="/" class="logo" aria-label="WelcomeToSerbia Shop Home">

      <img
        src="/favicon.webp"
        alt="WelcomeToSerbia Shop"
      />

      <div class="logo-text">
        <span>WELCOME TO</span>
        <span>SERBIA SHOP</span>
      </div>

    </a>


    <!-- MOBILE MENU BUTTON -->
    <button
      class="menu-toggle"
      id="menu-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="main-navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>


    <!-- MAIN NAVIGATION -->
    <nav
      class="main-navigation"
      id="main-navigation"
      aria-label="Main navigation"
    >

      <!-- PAGE LINKS -->
      <div class="internal-links">

        <a href="/">Home</a>

        <a href="/blog">Blog</a>

        <a href="/about">About</a>

        <a href="/services">Services</a>

      </div>


      <!-- TRANSLATION -->
      <div class="translation-wrapper">

        <span class="translation-label">
          <span class="translation-icon">🌐</span>
          <span>Language</span>
        </span>

        <div id="google_translate_element"></div>

      </div>


      <!-- SOCIAL LINKS -->
      <div class="social-links">

        <!-- Instagram -->
        <a
          href="https://www.instagram.com/residencyinserbia/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
        >
          <span class="sr-only">
            Follow WelcomeToSerbia Shop on Instagram
          </span>

          <img
            src="/INSTACIRCLE.png"
            alt="Instagram"
            width="24"
            height="24"
          />
        </a>


        <!-- X -->
        <a
          href="https://x.com/welcometos53932"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="X"
        >
          <span class="sr-only">
            Follow WelcomeToSerbia Shop on X
          </span>

          <svg
            viewBox="0 0 16 16"
            aria-hidden="true"
          >
            <path
              fill="currentColor"
              d="M5.026 15c6.038 0 9.341-5.003
              9.341-9.334 0-.14 0-.282-.006-.422
              A6.685 6.685 0 0 0 16 3.542
              a6.658 6.658 0 0 1-1.889.518
              3.301 3.301 0 0 0 1.447-1.817
              6.533 6.533 0 0 1-2.087.793
              A3.286 3.286 0 0 0 7.875 6.03
              a9.325 9.325 0 0 1-6.767-3.429
              3.289 3.289 0 0 0 1.018 4.382
              A3.323 3.323 0 0 1 .64 6.575v.045
              a3.288 3.288 0 0 0 2.632 3.218
              3.203 3.203 0 0 1-.865.115
              3.23 3.23 0 0 1-.614-.057
              3.283 3.283 0 0 0 3.067 2.277
              A6.588 6.588 0 0 1 .78 13.58
              a6.32 6.32 0 0 1-.78-.045
              A9.344 9.344 0 0 0 5.026 15z"
            />
          </svg>

        </a>


        <!-- Facebook -->
        <a
          href="https://www.facebook.com/profile.php?id=61585637589638"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
        >
          <span class="sr-only">
            Follow WelcomeToSerbia Shop on Facebook
          </span>

          <img
            src="/FBBLACK.webp"
            alt="Facebook"
            width="24"
            height="24"
          />
        </a>

      </div>

    </nav>

  </div>

</header>


<!-- =========================================================
     FOOTER
     ========================================================= -->

<footer class="site-footer">

  <p>
    © 2026 WelcomeToSerbia Shop. All rights reserved.
  </p>

</footer>


<!-- =========================================================
     MOBILE MENU JAVASCRIPT
     ========================================================= -->

<script is:inline>
  const menuToggle = document.getElementById("menu-toggle");
  const mainNavigation = document.getElementById("main-navigation");

  if (menuToggle && mainNavigation) {
    menuToggle.addEventListener("click", () => {

      const isOpen =
        mainNavigation.classList.toggle("menu-open");

      menuToggle.setAttribute(
        "aria-expanded",
        String(isOpen)
      );

      menuToggle.setAttribute(
        "aria-label",
        isOpen
          ? "Close navigation menu"
          : "Open navigation menu"
      );

    });


    /* Close mobile menu after selecting a page */
    mainNavigation
      .querySelectorAll(".internal-links a")
      .forEach((link) => {

        link.addEventListener("click", () => {

          mainNavigation.classList.remove("menu-open");

          menuToggle.setAttribute(
            "aria-expanded",
            "false"
          );

          menuToggle.setAttribute(
            "aria-label",
            "Open navigation menu"
          );

        });

      });
  }
</script>


<!-- =========================================================
     GOOGLE TRANSLATE JAVASCRIPT
     ========================================================= -->

<script is:inline>
  /*
   * Google Translate requires this callback to exist
   * BEFORE the Google Translate script loads.
   */

  window.googleTranslateElementInit = function () {

    if (
      window.google &&
      window.google.translate &&
      document.getElementById("google_translate_element")
    ) {

      new window.google.translate.TranslateElement(
        {
          pageLanguage: "en",
          includedLanguages: "en,ru",
          autoDisplay: false,
          layout:
            window.google.translate.TranslateElement.InlineLayout.SIMPLE
        },
        "google_translate_element"
      );

    }

  };
</script>


<script
  is:inline
  src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"
></script>
