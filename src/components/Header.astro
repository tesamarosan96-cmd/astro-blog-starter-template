---
/*
 * Main site header
 * Responsive for desktop, tablet and mobile.
 * Includes:
 * - WelcomeToSerbia Shop logo
 * - Navigation
 * - Google Translate
 * - Social media links
 */
---

<style is:global>
  /* =========================================================
     FONT
     ========================================================= */

  @font-face {
    font-family: 'Serbia Sans';
    src:
      url('/font/Srbija-sans.woff') format('woff'),
      url('/fonts/Srbija-sans.woff') format('woff');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }


  /* =========================================================
     GENERAL PAGE STYLES
     ========================================================= */

  html,
  body {
    margin: 0;
    padding: 0;

    font-family: 'Serbia Sans', sans-serif;

    background-color: #f0f4f8;

    color: #333;

    overflow-x: hidden;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }


  /* =========================================================
     HEADER
     ========================================================= */

  header {
    width: 100%;

    background: #0056b3;

    padding: 10px 24px;

    box-shadow:
      0 4px 12px rgba(0, 86, 179, 0.2);

    position: relative;

    z-index: 1000;
  }


  /* =========================================================
     HEADER INNER CONTAINER
     ========================================================= */

  .header-inner {
    width: 100%;

    max-width: 1400px;

    margin: 0 auto;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;
  }


  /* =========================================================
     LOGO
     ========================================================= */

  .logo {
    display: flex;

    align-items: center;

    gap: 12px;

    color: white;

    text-decoration: none;

    flex-shrink: 0;

    min-width: 0;
  }

  .logo img {
    width: 65px;

    height: 65px;

    object-fit: contain;

    display: block;

    flex-shrink: 0;
  }

  .logo-text {
    display: flex;

    flex-direction: column;

    justify-content: center;

    line-height: 1.15;

    color: white;

    font-size: 16px;

    font-weight: bold;

    white-space: nowrap;
  }

  .logo-text span {
    display: block;
  }


  /* =========================================================
     RIGHT SIDE OF HEADER
     ========================================================= */

  .header-right {
    display: flex;

    align-items: center;

    justify-content: flex-end;

    gap: 18px;

    min-width: 0;
  }


  /* =========================================================
     NAVIGATION
     ========================================================= */

  nav {
    display: flex;

    align-items: center;

    gap: 15px;

    min-width: 0;
  }

  .internal-links {
    display: flex;

    align-items: center;

    gap: 6px;

    flex-wrap: nowrap;
  }

  .internal-links a {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    text-decoration: none;

    color: #ffffff;

    padding: 8px 12px;

    border-radius: 6px;

    font-size: 15px;

    font-weight: 600;

    white-space: nowrap;

    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }

  .internal-links a:hover {
    background-color: #ffffff;

    color: #0056b3;

    text-decoration: none;
  }


  /* =========================================================
     LANGUAGE / TRANSLATION CONTROL
     ========================================================= */

  .translate-control {
    display: flex;

    align-items: center;

    gap: 8px;

    padding: 6px 9px;

    background: rgba(255, 255, 255, 0.12);

    border: 1px solid rgba(255, 255, 255, 0.55);

    border-radius: 8px;

    color: white;

    white-space: nowrap;

    flex-shrink: 0;
  }

  .translate-label {
    display: inline-flex;

    align-items: center;

    color: white;

    font-family: Arial, sans-serif;

    font-size: 13px;

    font-weight: 600;

    line-height: 1;
  }


  /* =========================================================
     GOOGLE TRANSLATE
     ========================================================= */

  #google_translate_element {
    display: flex;

    align-items: center;

    justify-content: center;

    background: white;

    border-radius: 5px;

    padding: 2px 5px;

    min-height: 30px;

    box-shadow:
      0 1px 4px rgba(0, 0, 0, 0.15);

    overflow: hidden;
  }

  #google_translate_element .goog-te-gadget {
    font-family: Arial, sans-serif !important;

    font-size: 0 !important;

    line-height: 1 !important;
  }

  #google_translate_element .goog-te-gadget select {
    font-family: Arial, sans-serif !important;

    font-size: 13px !important;

    color: #333 !important;

    background: #ffffff;

    border: none;

    border-radius: 4px;

    padding: 4px 5px;

    min-width: 100px;

    height: 27px;

    cursor: pointer;

    outline: none;
  }

  #google_translate_element .goog-te-gadget select:focus {
    outline: 2px solid #edb92e;

    outline-offset: 1px;
  }

  #google_translate_element .goog-te-gadget > span {
    display: none !important;
  }


  /* =========================================================
     HIDE GOOGLE TRANSLATE TOP BAR
     ========================================================= */

  .goog-te-banner-frame {
    display: none !important;
  }

  body {
    top: 0 !important;
  }

  .goog-te-balloon-frame {
    display: none !important;
  }


  /* =========================================================
     SOCIAL MEDIA
     ========================================================= */

  .social-links {
    display: flex;

    align-items: center;

    gap: 10px;

    flex-shrink: 0;
  }

  .social-links a {
    display: flex;

    align-items: center;

    justify-content: center;

    color: white;

    text-decoration: none;

    width: 32px;

    height: 32px;

    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  .social-links a:hover {
    opacity: 0.8;

    transform: scale(1.08);

    text-decoration: none;
  }

  .social-links img {
    width: 24px;

    height: 24px;

    object-fit: contain;

    border-radius: 0;
  }

  .social-links svg {
    width: 26px;

    height: 26px;

    display: block;
  }


  /* =========================================================
     MOBILE MENU BUTTON
     ========================================================= */

  .mobile-menu-button {
    display: none;

    border: 1px solid rgba(255, 255, 255, 0.6);

    background: rgba(255, 255, 255, 0.1);

    color: white;

    border-radius: 7px;

    padding: 7px 10px;

    font-size: 22px;

    line-height: 1;

    cursor: pointer;
  }

  .mobile-menu-button:hover {
    background: white;

    color: #0056b3;
  }


  /* =========================================================
     MOBILE MENU
     ========================================================= */

  .mobile-menu {
    display: none;
  }


  /* =========================================================
     TABLET
     ========================================================= */

  @media (max-width: 1100px) {

    header {
      padding: 10px 16px;
    }

    .header-inner {
      gap: 12px;
    }

    .logo {
      gap: 8px;
    }

    .logo img {
      width: 55px;

      height: 55px;
    }

    .logo-text {
      font-size: 14px;
    }

    .header-right {
      gap: 8px;
    }

    .internal-links {
      gap: 2px;
    }

    .internal-links a {
      padding: 7px 8px;

      font-size: 14px;
    }

    .translate-label {
      display: none;
    }

    .translate-control {
      padding: 4px 5px;

      margin: 0;
    }

    .social-links {
      display: none;
    }
  }


  /* =========================================================
     MOBILE
     ========================================================= */

  @media (max-width: 720px) {

    header {
      padding: 9px 12px;
    }

    .header-inner {
      position: relative;

      display: flex;

      align-items: center;

      justify-content: space-between;

      width: 100%;
    }

    .logo {
      gap: 8px;

      max-width: calc(100% - 60px);
    }

    .logo img {
      width: 48px;

      height: 48px;
    }

    .logo-text {
      font-size: 13px;

      line-height: 1.15;

      white-space: normal;
    }

    .mobile-menu-button {
      display: inline-flex;

      align-items: center;

      justify-content: center;

      flex-shrink: 0;
    }

    .header-right {
      display: none;
    }


    /* -----------------------------------------
       Mobile dropdown menu
       ----------------------------------------- */

    .mobile-menu {
      display: none;

      width: 100%;

      padding: 12px 0 5px;

      border-top:
        1px solid rgba(255, 255, 255, 0.25);

      margin-top: 10px;
    }

    .mobile-menu.open {
      display: block;
    }

    .mobile-menu .internal-links {
      display: flex;

      flex-direction: column;

      align-items: stretch;

      gap: 4px;

      width: 100%;
    }

    .mobile-menu .internal-links a {
      width: 100%;

      justify-content: flex-start;

      padding: 10px 12px;

      color: white;

      font-size: 16px;

      border-radius: 6px;
    }

    .mobile-menu .internal-links a:hover {
      background: white;

      color: #0056b3;
    }


    /* -----------------------------------------
       Mobile translation
       ----------------------------------------- */

    .mobile-translate {
      display: flex;

      align-items: center;

      flex-wrap: wrap;

      gap: 8px;

      margin-top: 12px;

      padding-top: 12px;

      border-top:
        1px solid rgba(255, 255, 255, 0.25);
    }

    .mobile-translate .translate-label {
      display: inline-flex;

      font-size: 14px;
    }

    .mobile-translate .translate-control {
      display: inline-flex;

      margin: 0;

      padding: 5px 7px;
    }


    /* -----------------------------------------
       Mobile social links
       ----------------------------------------- */

    .mobile-social {
      display: flex;

      align-items: center;

      gap: 12px;

      margin-top: 12px;

      padding-top: 12px;

      border-top:
        1px solid rgba(255, 255, 255, 0.25);
    }

    .mobile-social a {
      display: flex;

      align-items: center;

      justify-content: center;

      width: 32px;

      height: 32px;

      color: white;
    }
  }


  /* =========================================================
     VERY SMALL PHONES
     ========================================================= */

  @media (max-width: 380px) {

    header {
      padding-left: 9px;

      padding-right: 9px;
    }

    .logo img {
      width: 43px;

      height: 43px;
    }

    .logo-text {
      font-size: 12px;
    }

    .mobile-menu-button {
      padding: 6px 9px;

      font-size: 20px;
    }
  }
</style>


<!-- =========================================================
     HEADER
     ========================================================= -->

<header>

  <div class="header-inner">

    <!-- LOGO -->
    <a href="/" class="logo">

      <img
        src="/favicon.webp"
        alt="WelcomeToSerbia Shop"
      />

      <div class="logo-text">
        <span>WELCOME TO</span>
        <span>SERBIA SHOP</span>
      </div>

    </a>


    <!-- DESKTOP / TABLET RIGHT SIDE -->
    <div class="header-right">

      <nav aria-label="Main navigation">

        <div class="internal-links">

          <a href="/">Home</a>

          <a href="/blog">Blog</a>

          <a href="/about">About</a>

          <a href="/services">Services</a>

        </div>

      </nav>


      <!-- TRANSLATION -->
      <div class="translate-control">

        <span class="translate-label">
          🌐 Language
        </span>

        <div id="google_translate_element"></div>

      </div>


      <!-- SOCIAL MEDIA -->
      <div class="social-links">

        <a
          href="https://www.instagram.com/residencyinserbia/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="sr-only">
            Follow WelcomeToSerbia Shop on Instagram
          </span>

          <img
            src="/INSTACIRCLE.png"
            alt="Instagram"
            width="24"
            height="24"
          />
        </a>


        <a
          href="https://x.com/welcometos53932"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="sr-only">
            Follow WelcomeToSerbia Shop on X
          </span>

          <svg
            viewBox="0 0 16 16"
            aria-hidden="true"
            width="26"
            height="26"
          >
            <path
              fill="currentColor"
              d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
            />
          </svg>

        </a>


        <a
          href="https://www.facebook.com/profile.php?id=61585637589638"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="sr-only">
            Follow WelcomeToSerbia Shop on Facebook
          </span>

          <img
            src="/FBBLACK.webp"
            alt="Facebook"
            width="24"
            height="24"
          />

        </a>

      </div>

    </div>


    <!-- MOBILE MENU BUTTON -->
    <button
      class="mobile-menu-button"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      id="mobile-menu-button"
    >
      ☰
    </button>

  </div>


  <!-- =======================================================
       MOBILE MENU
       ======================================================= -->

  <div
    class="mobile-menu"
    id="mobile-menu"
  >

    <nav aria-label="Mobile navigation">

      <div class="internal-links">

        <a href="/">Home</a>

        <a href="/blog">Blog</a>

        <a href="/about">About</a>

        <a href="/services">Services</a>

      </div>

    </nav>


    <!-- MOBILE TRANSLATION -->

    <div class="mobile-translate">

      <div class="translate-control">

        <span class="translate-label">
          🌐 Language
        </span>

        <div id="google_translate_element_mobile"></div>

      </div>

    </div>


    <!-- MOBILE SOCIAL LINKS -->

    <div class="mobile-social">

      <a
        href="https://www.instagram.com/residencyinserbia/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
      >
        <img
          src="/INSTACIRCLE.png"
          alt="Instagram"
          width="24"
          height="24"
        />
      </a>


      <a
        href="https://x.com/welcometos53932"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="X"
      >
        <svg
          viewBox="0 0 16 16"
          aria-hidden="true"
          width="26"
          height="26"
        >
          <path
            fill="currentColor"
            d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a3.286 3.286 0 0 0-.95 2.282c0 .182.021.359.06.53A9.325 9.325 0 0 1 1.26 3.07a3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
          />
        </svg>
      </a>


      <a
        href="https://www.facebook.com/profile.php?id=61585637589638"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook"
      >
        <img
          src="/FBBLACK.webp"
          alt="Facebook"
          width="24"
          height="24"
        />
      </a>

    </div>

  </div>

</header>


<!-- =========================================================
     GOOGLE TRANSLATE
     ========================================================= -->

<script is:inline>

  function googleTranslateElementInit() {

    /*
     * Desktop translator
     */
    new google.translate.TranslateElement(
      {
        pageLanguage: 'en',
        includedLanguages: 'en,ru',
        autoDisplay: false,
        layout:
          google.translate.TranslateElement.InlineLayout.SIMPLE
      },
      'google_translate_element'
    );


    /*
     * Mobile translator
     */
    new google.translate.TranslateElement(
      {
        pageLanguage: 'en',
        includedLanguages: 'en,ru',
        autoDisplay: false,
        layout:
          google.translate.TranslateElement.InlineLayout.SIMPLE
      },
      'google_translate_element_mobile'
    );

  }

</script>


<script
  is:inline
  src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"
></script>


<!-- =========================================================
     MOBILE MENU JAVASCRIPT
     ========================================================= -->

<script is:inline>

  const menuButton =
    document.getElementById('mobile-menu-button');

  const mobileMenu =
    document.getElementById('mobile-menu');


  if (menuButton && mobileMenu) {

    menuButton.addEventListener('click', () => {

      const isOpen =
        mobileMenu.classList.toggle('open');

      menuButton.setAttribute(
        'aria-expanded',
        String(isOpen)
      );

      menuButton.setAttribute(
        'aria-label',
        isOpen
          ? 'Close menu'
          : 'Open menu'
      );

      menuButton.textContent =
        isOpen
          ? '✕'
          : '☰';

    });

  }

</script>


<!-- =========================================================
     FOOTER
     ========================================================= -->

<footer
  style="
    text-align: center;
    padding: 40px 20px;
    background: #ffffff;
    margin-top: 40px;
  "
>

  <p>
    &copy; 2026 WelcomeToSerbia Shop.
    All rights reserved.
  </p>

</footer>
