---
// No imports needed for this simple footer
---
<!-- Clean Footer (No blue bar, no "Your name here") -->
<footer style="text-align: center; padding: 20px; margin-top: 40px; color: #666;">
  <p>&copy; 2026 WelcomeToSerbia Shop. All rights reserved.</p>
  
  <div class="social-links-footer" style="margin-top: 15px;">
    <!-- Instagram -->
    <a href="https://www.instagram.com/residencyinserbia/" target="_blank" style="margin: 0 10px;">
      <img src="/INSTACIRCLE.png" alt="Instagram" width="24" style="height: auto;" />
    </a>
    <!-- X (Twitter) -->
    <a href="https://x.com/welcometos53932" target="_blank" style="margin: 0 10px;">
      <svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
        <path fill="currentColor" d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"></path>
      </svg>
    </a>
    <!-- Facebook -->
    <a href="https://www.facebook.com/profile.php?id=61585637589638" target="_blank" style="margin: 0 10px;">
      <img src="/FBBLACK.webp" alt="Facebook" width="24" style="height: auto;" />
    </a>
  </div>
<!-- WhatsApp floating button -->
  <style>
    .wa-bubble {
      position: fixed;
      right: 20px;
      bottom: 20px;
      z-index: 9999;
      display: grid;
      place-items: center;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: #25D366;
      box-shadow: 0 4px 14px rgba(0,0,0,.25);
      transition: transform .15s ease;
    }
    .wa-bubble:hover { transform: scale(1.08); }
    @media (max-width: 600px) {
      .wa-bubble { right: 14px; bottom: 14px; width: 50px; height: 50px; }
    }
  </style>
  <a class="wa-bubble"
     href="https://wa.me/381665231087?text=Hello%2C%20I%27m%20interested%20in%20your%20services"
     target="_blank"
     rel="noopener"
     aria-label="Message us on WhatsApp">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="#ffffff" aria-hidden="true">
      <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1-.6.8-.7.9-.3.2-.5.1a6.7 6.7 0 0 1-2-1.2 7.4 7.4 0 0 1-1.4-1.7c-.1-.3 0-.4.1-.5l.4-.4.2-.4v-.4l-.7-1.6c-.2-.4-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.1 5 5 0 0 0 1 2.7 11 11 0 0 0 4.3 3.8c1.6.6 1.9.5 2.3.5a2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .1-1.2c0-.1-.2-.2-.4-.3z"/>
    </svg>
  </a>
</footer>
