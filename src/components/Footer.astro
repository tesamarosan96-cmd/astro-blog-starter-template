---
// No imports needed for this simple footer
---
<!-- Clean Footer (No blue bar, no "Your name here") -->
<footer style="text-align: center; padding: 20px; margin-top: 40px; color: #666;">
  <p>&copy; 2026 WelcomeToSerbia Shop. All rights reserved.</p>

  <div class="social-links-footer" style="margin-top: 15px;">
    <!-- Instagram -->
    <a href="https://www.instagram.com/residencyinserbia/" target="_blank" rel="noopener noreferrer" style="margin: 0 10px;">
      <img src="/INSTACIRCLE.png" alt="Instagram" width="24" style="height: auto;" />
    </a>
    <!-- X (Twitter) -->
    <a href="https://x.com/welcometos53932" target="_blank" rel="noopener noreferrer" style="margin: 0 10px;">
      <svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
        <path fill="currentColor" d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"></path>
      </svg>
    </a>
    <!-- Facebook -->
    <a href="https://www.facebook.com/profile.php?id=61585637589638" target="_blank" rel="noopener noreferrer" style="margin: 0 10px;">
      <img src="/FBBLACK.webp" alt="Facebook" width="24" style="height: auto;" />
    </a>
  </div>

  <!-- WhatsApp floating button -->
  <a href="https://wa.me/381665231087?text=Hi%2C%20I%27d%20like%20to%20ask%20about..."
     class="wa-float"
     target="_blank"
     rel="noopener noreferrer"
     aria-label="Chat with us on WhatsApp">
    <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" fill="currentColor">
      <path d="M16 3C9.4 3 4 8.4 4 15c0 2.4.7 4.6 1.9 6.5L4 29l7.7-2c1.8 1 3.9 1.6 6.1 1.6h.2C24.6 28.6 30 23.2 30 16.6 30 9.4 24.6 3 16 3zm0 23.1c-1.9 0-3.7-.5-5.3-1.5l-.4-.2-4.6 1.2 1.2-4.5-.2-.4A11 11 0 015 16c0-6 4.9-11 11-11s11 4.9 11 11-4.9 11.1-11 11.1z"/>
      <path d="M22.3 18.6c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2s-.8 1-1 1.2c-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.6l.5-.6c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.6s-.7-1.7-.9-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.7s1.2 3.1 1.3 3.3c.2.2 2.3 3.5 5.6 4.9 2.8 1.1 3.3.9 3.9.9.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.6-.1-.1-.3-.2-.6-.3z"/>
    </svg>
  </a>

  <style>
    .wa-float {
      position: fixed;
      right: 20px;
      bottom: calc(20px + env(safe-area-inset-bottom));
      z-index: 9999;
      display: grid;
      place-items: center;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: #25d366;
      color: #fff;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
      transition: transform 0.15s ease;
    }
    .wa-float:hover { transform: scale(1.06); }
    @media (max-width: 600px) {
      .wa-float { right: 14px; bottom: calc(14px + env(safe-area-inset-bottom)); width: 50px; height: 50px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .wa-float { transition: none; }
    }
  </style>
</footer>
